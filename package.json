{
  "name": "jaxfit-web",
  "version": "1.0.0",
  "private": true,
  "description": "JaxFit: intermittent fasting, BMI, calorie deficit and water intake calculators, 100% in the browser. Static export for GitHub Pages.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run build",
    "test": "node scripts/test.mjs",
    "images": "node scripts/make-images.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.3",
    "playwright": "1.65.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
